#!/usr/bin/env bash
# Hook shim shipped in the plugin: runs the hyprcage hook when the binary is
# there and stays silent otherwise (the first session after installing the
# plugin can start before the MCP launcher has fetched the binary).
bin=$(command -v hyprcage 2>/dev/null || true)
[ -z "$bin" ] && [ -x "$HOME/.local/bin/hyprcage" ] && bin=$HOME/.local/bin/hyprcage
[ -n "$bin" ] || exit 0
exec "$bin" "$@"
